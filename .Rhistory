library(rmarkdown)
library(tidyverse)
# Set Git identity (match your GitHub)
usethis::use_git_config(
user.name = "Evan Ulrich",
user.email = "YOUR_EMAIL_HERE"
)
# Set GitHub credentials
library(gitcreds)
gitcreds::gitcreds_set()
library(gitcreds)
gitcreds::gitcreds_set()
